{
  "name": "@oam/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript SDK for the OnChain Asset Manager contracts: calldata, read descriptors, typed data and parsers. No I/O. See sdk.md.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:fork": "vitest run --project fork"
  },
  "dependencies": {
    "@oam/abi": "*"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.2.2",
    "@types/node": "^25.9.2",
    "fast-check": "^4.3.0",
    "typescript": "^6.0.3",
    "viem": "^2.52.2",
    "vitest": "^3.2.4"
  }
}
