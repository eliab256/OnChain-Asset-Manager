{
  "name": "@oam/abi",
  "version": "0.1.0",
  "private": true,
  "description": "ABIs generated from the Foundry artifacts and addresses from deployments/. Do not edit src/generated.ts by hand.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "forge build --root ../.. && wagmi generate",
    "watch": "forge build --root ../.. && (forge build --root ../.. --watch & wagmi generate --watch)",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@wagmi/cli": "^2.10.0"
  }
}
