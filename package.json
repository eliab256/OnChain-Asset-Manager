{
  "name": "onchain-asset-manager",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "abi": "npm run generate --workspace @oam/abi",
    "abi:watch": "npm run watch --workspace @oam/abi",
    "check-abi": "packages/abi/check-abi.sh",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "viem": "^2.52.2"
  }
}
