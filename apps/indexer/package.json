{
  "name": "@oam/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain indexer: reads the protocol events and stores them in the DB of @oam/db (roadmap phase 4). See indexer.md.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oam/abi": "*",
    "@oam/db": "*",
    "@oam/sdk": "*",
    "dotenv": "^17.4.2",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
