# Copy to apps/indexer/.env. Variables are described in apps/indexer/indexer.md §2.

# HTTP RPC of the chain: every read goes through it
RPC_URL=http://127.0.0.1:8545

# WebSocket RPC of the same chain, only to be told about new blocks (optional: empty = polling only)
RPC_WS_URL=ws://127.0.0.1:8545

# 31337 = pure anvil (make dev), 31338 = mainnet fork (DEV_PROFILE=fork make dev)
CHAIN_ID=31337

# Same database as packages/db/.env (local Postgres of docker-compose.yml)
DATABASE_URL=postgresql://oam:oam@localhost:5434/oam

# Integration tests only (npm run test:integration), never read by the indexer process: a separate
# database of the same Postgres, emptied by the tests. The name must end in _test. Created by the
# test setup (prisma migrate deploy) if it does not exist
TEST_DATABASE_URL=postgresql://oam:oam@localhost:5434/oam_test

# Integration tests only: anvil with the deployment of deployments/31337.json (make dev, or
# anvil --load-state .anvil/31337.json). Default http://127.0.0.1:8545; without such a node the anvil
# suites are skipped. Not RPC_URL, which may point at the fork
TEST_RPC_URL=http://127.0.0.1:8545

# Blocks per getLogs call (default 2000). Must not exceed the provider's eth_getLogs block range:
# no limit on anvil, 10 on Alchemy free tier
BATCH_SIZE=2000

# HTTP head polling in ms: fallback of the WebSocket (default 30000); use 1000 without RPC_WS_URL
POLL_INTERVAL_MS=30000
