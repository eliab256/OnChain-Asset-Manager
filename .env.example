# Copy to .env. Read by the Makefile, the Foundry fork tests and docker compose.

# Archive RPC of Ethereum mainnet: fork tests and make anvil-fork / DEV_PROFILE=fork
MAINNET_RPC_URL=

# Deployer address, read by HelperConfig only when running on mainnet
MAINNET_DEPLOYER=

# Host port of the local Postgres (docker-compose.yml). Not 5432, often taken by a system Postgres
POSTGRES_PORT=5434
